ARG BASE_IMAGE=ubuntu:24.04

FROM ${BASE_IMAGE} AS builder

ARG DEVICE_TARGET=gfx942
ARG FETCHCONTENT_GIT_SSL_NO_VERIFY=false
ARG ROCM_TORCH_INDEX_URL=https://rocm.nightlies.amd.com/whl-multi-arch/

ENV DEBIAN_FRONTEND=noninteractive \
    HIP_PLATFORM=amd \
    BENCHMARK_WORKSPACE=/opt/dnn-benchmark \
    BENCHMARK_VENV=/opt/dnn-benchmark/.venv \
    WORKSPACE_DIR=/workspace \
    GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        ccache \
        cmake \
        git \
        ninja-build \
        python3.12 \
        python3.12-dev \
        python3.12-venv && \
    rm -rf /var/lib/apt/lists/*

WORKDIR ${WORKSPACE_DIR}

COPY . .

RUN --mount=type=cache,target=/root/.cache/pip <<'EOF'
set -eu

case "${DEVICE_TARGET}" in
    gfx90a | gfx942 | gfx950 | gfx1151 | gfx1152) ;;
    *)
        echo "Unsupported DEVICE_TARGET='${DEVICE_TARGET}'. Expected gfx90a, gfx942, gfx950, gfx1151, or gfx1152." >&2
        exit 1
        ;;
esac


if [ "${FETCHCONTENT_GIT_SSL_NO_VERIFY}" = "true" ]; then
    export GIT_SSL_NO_VERIFY=true
    export PIP_TRUSTED_HOST="pypi.org files.pythonhosted.org"
fi


set -- \
    --workspace "${BENCHMARK_WORKSPACE}" \
    --torch-mode rocm \
    --gpu-arch "${DEVICE_TARGET}" \
    --no-editable \
    -y
if [ -n "${ROCM_TORCH_INDEX_URL}" ]; then
    set -- "$@" --torch-index-url "${ROCM_TORCH_INDEX_URL}"
fi

python3.12 setup_env.py "$@"


# rocm-sdk-devel is build-only. Runtime keeps the ROCm torch/core/libraries
# wheels plus the hipDNN/providers installed into the libraries wheel prefix.
tools_target="$("${BENCHMARK_VENV}/bin/python" -m rocm_sdk path --root | tail -n 1)"
"${BENCHMARK_VENV}/bin/python" -m pip uninstall -y rocm-sdk-devel
rm -rf "${tools_target}"

printf 'Benchmark venv: %s\n' "${BENCHMARK_VENV}"
EOF


FROM ${BASE_IMAGE} AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    HIP_PLATFORM=amd \
    BENCHMARK_WORKSPACE=/opt/dnn-benchmark \
    BENCHMARK_VENV=/opt/dnn-benchmark/.venv \
    WORKSPACE_DIR=/workspace \
    PATH=/opt/dnn-benchmark/.venv/bin:${PATH}

# Keep development headers out of the runtime image. MIOpen's HIPRTC path ships
# its own cstdint shim; installing libc6-dev exposes system stdint typedefs that
# conflict with that shim during runtime kernel compilation.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libatomic1 \
        libdrm2 \
        libelf1 \
        libgcc-s1 \
        libgomp1 \
        libnuma1 \
        libstdc++6 \
        libtinfo6 \
        python3.12 \
        linux-tools-common \
        linux-tools-generic \
        libsqlite3-0 && \
    rm -rf /var/lib/apt/lists/*


# Profiling sources in this image (setup_env.py prints the same summary):
#
#  * --pmc / --emit-trace: rocprofv3 comes from the ROCm wheels, and this
#    image deliberately installs no system ROCm, so the profiler and the
#    workload always share one ROCm build. Mixing two is what makes
#    rocprofv3 abort on a duplicate librocprofiler-sdk registration.
#  * --roofline: rocprof-compute is NOT installed. It ships in the
#    rocprofiler-compute system package, which would pull a second ROCm
#    into the image and reintroduce the mismatch above. Run roofline on a
#    host with a full ROCm install instead.
#
# linux-tools-{common,generic} provide the `perf` binary required by
# dnn-benchmarking's `--perf` source (CPU cycles/IPC). Two runtime
# gotchas the apt install can't fix:
#
#  * Container kernel mismatch — the perf wrapper dispatches to
#    `perf_<kernel-version>` and exits 2 when that build is absent,
#    which is the normal case here: the image ships tools for its own
#    kernel, the container runs the host's. dnn-benchmarking then uses
#    the image's build from /usr/lib/linux-tools* and labels the slice
#    `binary_substituted`. For counters from a matched perf, install
#    `linux-tools-$(uname -r)` for the *host* kernel.
#  * Kernel-event collection (`cycles:k`) needs
#    `/proc/sys/kernel/perf_event_paranoid <= 1` OR `CAP_PERFMON` /
#    `CAP_SYS_ADMIN`. The sysctl is not namespaced, so the container
#    reads the host's value — but `--cap-add=PERFMON` (or a privileged
#    container) bypasses it without touching the host. The image runs as
#    the non-root `dnnbench` user, which does not get added capabilities,
#    so also pass `--user root` with `--cap-add=PERFMON`. Failing both,
#    the run records user-space counters only and reports the paranoid
#    value next to the None kernel fields. See docs/troubleshooting.md.

COPY --from=builder /opt/dnn-benchmark /opt/dnn-benchmark

# MIOpen's HIPRTC activation path includes libc++ <cstdint> before MIOpen's own
# miopen_cstdint.hpp. Runtime must not install glibc development headers (their
# LP64 fixed-width typedefs conflict with MIOpen's HIPRTC LL64 shim), but libc++
# still needs global intmax_t/uintmax_t for std::intmax_t. Provide only those
# max-width typedefs and let miopen_cstdint.hpp define int8_t/int64_t/etc.
RUN cat > /usr/local/include/stdint.h <<'EOF'
#ifndef DNN_BENCHMARKING_HIPRTC_STDINT_MAX_ONLY_H
#define DNN_BENCHMARKING_HIPRTC_STDINT_MAX_ONLY_H
typedef long long intmax_t;
typedef unsigned long long uintmax_t;
#define INTMAX_MAX 9223372036854775807LL
#define INTMAX_MIN (-9223372036854775807LL - 1)
#define UINTMAX_MAX 18446744073709551615ULL
#define INTMAX_C(v) v##LL
#define UINTMAX_C(v) v##ULL
#endif
EOF

WORKDIR ${WORKSPACE_DIR}
COPY graphs ./graphs

RUN cat > /usr/local/bin/dnn-benchmark-performance <<'SCRIPT' && \
    chmod 0755 /usr/local/bin/dnn-benchmark-performance
#!/usr/bin/env bash
set -euo pipefail


exec /opt/dnn-benchmark/.venv/bin/dnn-benchmark "$@"
SCRIPT

# Run as a non-root user. /dev/kfd and /dev/dri/renderD* are owned by the
# host's `video` and `render` groups. The image adds `video` (GID 44 on
# Ubuntu). The host `render` GID varies, so pass it at run time:
#   docker run --device /dev/kfd --device /dev/dri \
#     --group-add video --group-add "$(getent group render | cut -d: -f3)" ...
RUN useradd --create-home --user-group --groups video dnnbench && \
    chown dnnbench:dnnbench "${WORKSPACE_DIR}"
USER dnnbench

# One-shot benchmark CLI, not a long-running service.
HEALTHCHECK NONE

ENTRYPOINT ["dnn-benchmark-performance"]
CMD []
